# =============================================================
#  生产环境配置模板
#  复制为 server/.env 后按实际情况修改
#
#  ⚠️ 这个文件不要提交到公开仓库
# =============================================================

NODE_ENV=production
PORT=3000

# ---------------------------------------------------------------
# 数据库
# 生产环境不要用 root，建一个只对 lab_booking 有权限的专用账号：
#
#   CREATE USER 'lab_app'@'localhost' IDENTIFIED BY '换成强密码';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON lab_booking.* TO 'lab_app'@'localhost';
#   FLUSH PRIVILEGES;
#
#  注意：这里故意没给 DROP / ALTER 权限 —— 应用跑起来不需要建表改表，
#  少一分权限就少一分被拖库后清空数据的风险。
# ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lab_app
DB_PASSWORD=换成强密码
DB_NAME=lab_booking

# ---------------------------------------------------------------
# JWT 密钥
# 必须是长随机串，生成方式：
#   openssl rand -base64 48
#
# 代码里有硬性检查：NODE_ENV=production 时若密钥还是开发默认值，
# 服务会直接拒绝启动，避免带着默认密钥上线。
# ---------------------------------------------------------------
JWT_SECRET=用openssl生成一串替换掉这里
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------
# 允许跨域的前端地址
# 前后端同域部署（Nginx 反代）时其实用不到 CORS，
# 但保留配置以防将来前端独立部署到别的域名
# ---------------------------------------------------------------
CORS_ORIGIN=https://your-domain.com
