# ===== 复制此文件为 .env 后按实际情况修改 =====

# 服务端口
PORT=3000
NODE_ENV=development

# MySQL 连接（本地开发用 root 免密）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lab_booking

# JWT 密钥 —— 部署到公网前务必换成一串长随机字符
JWT_SECRET=dev_only_change_me_before_deploy
JWT_EXPIRES_IN=7d

# 允许跨域的前端地址（Vite 开发服务器默认 5173）
CORS_ORIGIN=http://localhost:5173
